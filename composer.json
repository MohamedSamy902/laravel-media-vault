{
    "name": "mohamedsamy902/laravel-media-vault",
    "description": "A production-grade, security-hardened media management & chunked file upload package for Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "media-vault", "media-vault", "image", "storage", "s3", "chunk", "cdn", "thumbnail", "ssrf", "resumable"],
    "homepage": "https://github.com/MohamedSamy902/laravel-media-vault",
    "support": {
        "source": "https://github.com/MohamedSamy902/laravel-media-vault",
        "issues": "https://github.com/MohamedSamy902/laravel-media-vault/issues"
    },
    "authors": [
        {
            "name": "Mohamed Samy",
            "email": "mohamedsamy902@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": ">=10.0",
        "intervention/image": "^3.0",
        "enshrined/svg-sanitize": "^0.22.0"
    },
    "suggest": {
        "league/flysystem-aws-s3-v3": "Required for Amazon S3 storage: ^3.0",
        "spatie/laravel-google-cloud-storage": "Required for Google Cloud Storage: ^2.0",
        "spatie/image-optimizer": "Optional image optimization pipeline: ^1.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^1.10",
        "guzzlehttp/guzzle": "^7.8"
    },
    "autoload": {
        "psr-4": {
            "MohamedSamy902\\LaravelMediaVault\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MohamedSamy902\\LaravelMediaVault\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MohamedSamy902\\LaravelMediaVault\\LaravelMediaVaultServiceProvider"
            ],
            "aliases": {
                "MediaVault": "MohamedSamy902\\LaravelMediaVault\\Facades\\MediaVault"
            }
        }
    },
    "scripts": {
        "test":    "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse src --level=6"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
